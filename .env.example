PORT=3000

SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_USERNAME=postgres
SQL_PASSWORD=postgres
SQL_DATABASE=multi_tenant_nest

# Set to true only for local prototyping without migrations (default: off).
TYPEORM_SYNCHRONIZE=false

JWT_SECRET=replace_me
JWT_ACCESS_SECRET=replace_me
JWT_REFRESH_SECRET=replace_me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# Seed command defaults (used by `npm run db:reset-seed`)
SEED_TENANT_ID=00000000-0000-4000-8000-000000000001
SEED_TENANT_NAME=Default Tenant
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=OwnerPass@123
SEED_OWNER_NAME=Owner User
SEED_OWNER_PHONE=9999999999
SEED_OWNER_ADDRESS=Seeded Owner Address
